#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 3 ]] || exit 2
low=$1
mid=$2
max=$3
for value in "$low" "$mid" "$max"; do
  [[ "$value" =~ ^[0-9]{2}$|^[0-9]{3}$ ]] || exit 2
done
(( low >= 30 && low < mid && mid < max && max <= 90 )) || exit 2

tmp=$(mktemp /etc/mbpfan.conf.XXXXXX)
trap 'rm -f "$tmp"' EXIT
printf '[general]\nlow_temp = %s\nhigh_temp = %s\nmax_temp = %s\npolling_interval = 2\n' "$low" "$mid" "$max" > "$tmp"
chmod 0644 "$tmp"
cp -a /etc/mbpfan.conf "/etc/mbpfan.conf.bak.$(date +%s)"
mv "$tmp" /etc/mbpfan.conf
trap - EXIT

if [[ ! -e /run/omarchy-fan-max ]]; then
  systemctl restart mbpfan.service
fi

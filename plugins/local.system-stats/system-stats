#!/usr/bin/env bash

set -u
export LC_ALL=C

cpu_snapshot() {
  awk '/^cpu / {
    total = $2 + $3 + $4 + $5 + $6 + $7 + $8 + $9 + $10
    idle = $5 + $6
    printf "%d %d\n", total, idle
    exit
  }' /proc/stat
}

read -r total_a idle_a < <(cpu_snapshot)
sleep 0.12
read -r total_b idle_b < <(cpu_snapshot)

cpu_usage=$(awk -v ta="${total_a:-0}" -v ia="${idle_a:-0}" \
  -v tb="${total_b:-0}" -v ib="${idle_b:-0}" 'BEGIN {
    total = tb - ta
    idle = ib - ia
    if (total <= 0) print 0
    else {
      value = (total - idle) * 100 / total
      if (value < 0) value = 0
      if (value > 100) value = 100
      printf "%.0f", value
    }
  }')

freq_sum=0
freq_count=0
for freq_path in /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq \
                 /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq; do
  if [ -r "$freq_path" ]; then
    read -r freq_khz < "$freq_path" || true
    if [[ "${freq_khz:-}" =~ ^[0-9]+$ ]]; then
      freq_sum=$((freq_sum + freq_khz))
      freq_count=$((freq_count + 1))
    fi
  fi
done

if [ "$freq_count" -gt 0 ]; then
  cpu_ghz=$(awk -v sum="$freq_sum" -v count="$freq_count" 'BEGIN { printf "%.2f", sum / count / 1000000 }')
else
  cpu_ghz=$(awk '/^cpu MHz/ { sum += $4; count++ } END {
    if (count > 0) printf "%.2f", sum / count / 1000
    else print "null"
  }' /proc/cpuinfo)
fi

ram_values=$(awk '
  /^MemTotal:/     { total = $2 }
  /^MemAvailable:/ { available = $2 }
  END {
    if (total > 0) {
      used = total - available
      printf "%.2f %.2f %.0f", used / 1048576, total / 1048576, used * 100 / total
    } else print "null null null"
  }' /proc/meminfo)
read -r ram_used_gb ram_total_gb ram_usage <<< "$ram_values"

disk_values=$(df -P -B1 / 2>/dev/null | awk 'NR == 2 {
  usage = $5
  gsub(/%/, "", usage)
  printf "%.2f %.2f %s", $3 / 1073741824, $2 / 1073741824, usage
}')
read -r ssd_used_gb ssd_total_gb ssd_usage <<< "$disk_values"
ssd_used_gb=${ssd_used_gb:-null}
ssd_total_gb=${ssd_total_gb:-null}
ssd_usage=${ssd_usage:-null}

json_number() {
  case "${1:-}" in
    ""|null|*[!0-9.-]*) printf 'null' ;;
    *) printf '%s' "$1" ;;
  esac
}

printf '{"cpu":{"usage":%s,"ghz":%s},' "$(json_number "$cpu_usage")" "$(json_number "$cpu_ghz")"
printf '"ram":{"usage":%s,"used_gb":%s,"total_gb":%s},' \
  "$(json_number "$ram_usage")" "$(json_number "$ram_used_gb")" "$(json_number "$ram_total_gb")"
printf '"ssd":{"usage":%s,"used_gb":%s,"total_gb":%s}}\n' \
  "$(json_number "$ssd_usage")" "$(json_number "$ssd_used_gb")" "$(json_number "$ssd_total_gb")"
